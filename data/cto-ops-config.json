  "enhance": {
    "enabled": false,
    "baseUrl": "https://api.enhance.com",
    "bearerTokenEnv": "ENHANCE_BEARER_TOKEN",
    "orgIds": [
      "8a33857a-cb89-4372-ab29-4d887c961d89"
    ],
    "dnsRecordTargets": []
  }
